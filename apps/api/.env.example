# ─────────────────────────────────────────────────────────────────────
# Nurox ERP API — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
#
# All variables validated at boot by Zod (see src/config/env.validation.ts)
# The app will NOT start if required vars are missing or malformed.
# ─────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001

# Database (PostgreSQL 17)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nurox
DB_PASSWORD=nurox_password
DB_NAME=nurox_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — RS256 asymmetric keys for access tokens
# In dev mode, keys are auto-generated if not provided.
# In production, MUST provide PEM-encoded keys.
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m

# JWT — HMAC secrets for refresh + magic link tokens
# In dev mode, random secrets are auto-generated if not provided.
# In production, these are REQUIRED (app will crash without them).
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
JWT_MAGIC_LINK_SECRET=
JWT_MAGIC_LINK_EXPIRY=10m

# CORS — comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail (MailHog for local dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Nurox ERP" <noreply@nurox.app>

# OAuth (optional — for SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/auth/microsoft/callback

# S3 / MinIO (local dev uses MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=nurox-erp
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/nurox-erp

# AI (optional)
OPENAI_API_KEY=
