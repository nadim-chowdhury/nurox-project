# Exclude dependencies
node_modules/
**/node_modules/

# Exclude build and cache outputs
.next/
**/.next/
dist/
**/dist/
.turbo/
**/.turbo/
.cache/
**/.cache/
out/
**/out/

# Exclude IDE/editor files and secrets
.env
.env.local
.env.*.local
.git/
.github/
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Exclude OS metadata
.DS_Store
Thumbs.db
