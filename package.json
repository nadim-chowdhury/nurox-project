{
  "name": "nurox-project",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:up": "docker compose --env-file .env.docker up --build -d",
    "docker:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:verify": "node scripts/docker-verify.js",
    "ai:context": "node scripts/copy-ai-context.js",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:api": "pnpm --filter web test:e2e:api",
    "test:e2e:ui": "pnpm --filter web test:e2e:ui",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.24.0",
      "@tiptap/pm": "3.24.0",
      "@tiptap/extension-highlight": "3.24.0",
      "@tiptap/suggestion": "3.24.0"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0"
  }
}
