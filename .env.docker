# NUROX ERP — Docker Environment Configuration
# This file is used by the root docker-compose.yml

# ─── APP ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── DATABASE ─────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=nurox
DB_PASSWORD=nurox_prod_password
DB_NAME=nurox_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── REDIS ────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

