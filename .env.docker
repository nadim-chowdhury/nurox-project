# NUROX ERP — Docker Environment Configuration
# This file is used by the root docker-compose.yml

# ─── APP ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── DATABASE ─────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=nurox
DB_PASSWORD=nurox_prod_password
DB_NAME=nurox_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── REDIS ────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────
# NOTE: In production, these should be proper RS256 PEM keys.
# For this docker setup, the app will auto-generate if empty.
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=nurox_ultra_secure_refresh_secret_2026
JWT_REFRESH_EXPIRY=7d
JWT_MAGIC_LINK_SECRET=nurox_ultra_secure_magic_secret_2026
JWT_MAGIC_LINK_EXPIRY=10m

# ─── MAIL ─────────────────────────────────────────────────────────
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Nurox ERP" <noreply@nurox.app>

# ─── S3 / MINIO ───────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=nurox-erp
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/nurox-erp

# ─── SEARCH ───────────────────────────────────────────────────────
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=nurox_meili_master_key

# ─── FRONTEND ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_TELEMETRY_DISABLED=1
