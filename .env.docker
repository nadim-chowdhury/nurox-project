NODE_ENV=production
PORT=3001

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=nurox
DB_PASSWORD=nurox_prod_password
DB_NAME=nurox_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DOCKER_DB_BOOTSTRAP=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT & Secrets
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_SECRET=nurox_production_refresh_secret_key_2026_secure
JWT_MAGIC_LINK_SECRET=nurox_magic_link_secret_key_2026_secure

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MeiliSearch
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=nurox_meili_master_key

# MinIO
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nurox-documents
S3_REGION=us-east-1

# Mail
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=noreply@nurox.app

# Frontend & Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
INTERNAL_API_URL=http://api:3001/api/v1
